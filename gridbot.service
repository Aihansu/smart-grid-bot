[Unit]
Description=Smart Grid Bot v3.0
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/root/smart_grid_bot
ExecStart=/usr/bin/python3 /root/smart_grid_bot/main_v3_0.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gridbot

[Install]
WantedBy=multi-user.target
